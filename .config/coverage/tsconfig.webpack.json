{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "outDir": "../../dist",
    "strict": true,
    "lib": [
      "ES2020",
      "DOM"
    ]
  },
  "include": [
    "./webpack.coverage.config.js"
  ]
}