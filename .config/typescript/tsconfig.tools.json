/**
 * TypeScript configuration for build tools and utility scripts
 * This configuration is used for:
 * - Build scripts in config/build directory
 * - Utility scripts in utils directory
 * 
 * This config extends the base config and adds specific settings for tools.
 */
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "types": [
      // "node"
    ],
    "outDir": "../../dist/tools",
    "esModuleInterop": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "ts-node": {
    "esm": true
  },
  "include": [
    "../build/tsup.config.ts",
    "../test/cypress.config.js",
    "../test/jest.config.ts",
    "../test/jest.setup.ts",
  ]
}